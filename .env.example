OPENAI_API_KEY=sk-...
# Optional override, defaults to gpt-4o-mini
FOREMAN_MODEL=gpt-4o-mini

# Login for the dashboard and API. Both are required unless FOREMAN_AUTH=off.
# Password: at least 12 characters. Secret key: any long random string, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
FOREMAN_PASSWORD=
FOREMAN_SECRET_KEY=

# Only for running on your own machine over plain http:
# FOREMAN_AUTH=off
# FOREMAN_SECURE_COOKIES=off

# Where the SQLite database lives (gitignored)
# FOREMAN_DB=data/foreman.db
